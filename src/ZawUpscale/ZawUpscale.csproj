<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZawUpscale</AssemblyName>
    <RootNamespace>ZawUpscale</RootNamespace>
    <Version>1.0.0</Version>
    <Product>ZawUpscale</Product>
    <!-- Windows executable icon (generated from assets/icon by build-icons.ps1). Embedded only when building on Windows. -->
    <ApplicationIcon>zawupscale.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- Desktop app, not an IIS site: skip web.config and the static web assets manifest. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- No console window for published Windows builds; `dotnet run` keeps the console for logs. -->
    <OutputType Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">WinExe</OutputType>
  </PropertyGroup>

  <!--
    The GPU backend, by platform. Windows: the DirectML build of ONNX Runtime (any DirectX 12 GPU: NVIDIA, AMD, Intel).
    macOS: Core ML (GPU and Neural Engine), which the standard build includes. Linux: the CPU build, or with
    -p:ZawCuda=true the CUDA build for NVIDIA GPUs (linux-x64 only; much larger, and it needs CUDA 12 and cuDNN 9).
  -->
  <PropertyGroup>
    <ZawTargetsWindows Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">true</ZawTargetsWindows>
    <ZawTargetsWindows Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</ZawTargetsWindows>
    <ZawTargetsMac Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx'))">true</ZawTargetsMac>
    <ZawTargetsMac Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">true</ZawTargetsMac>
    <ZawGpu>none</ZawGpu>
    <ZawGpu Condition="'$(ZawTargetsWindows)' == 'true'">directml</ZawGpu>
    <ZawGpu Condition="'$(ZawTargetsMac)' == 'true'">coreml</ZawGpu>
    <ZawGpu Condition="'$(ZawCuda)' == 'true'">cuda</ZawGpu>
    <DefineConstants Condition="'$(ZawGpu)' == 'directml'">$(DefineConstants);DIRECTML</DefineConstants>
    <DefineConstants Condition="'$(ZawGpu)' == 'coreml'">$(DefineConstants);COREML</DefineConstants>
    <DefineConstants Condition="'$(ZawGpu)' == 'cuda'">$(DefineConstants);CUDA</DefineConstants>
  </PropertyGroup>

  <Target Name="ZawCheckCuda" BeforeTargets="Restore;Build" Condition="'$(ZawCuda)' == 'true'">
    <Error Condition="'$(RuntimeIdentifier)' != 'linux-x64' and !('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')))"
      Text="The CUDA build (ZawCuda=true) is for linux-x64 only; Windows uses DirectML for every GPU." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <!-- AVIF, HEIC, TIFF and JPEG XL, and animated GIF and WebP frames, which Skia can't read or write. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" Condition="'$(ZawGpu)' == 'directml'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" Version="1.24.4" Condition="'$(ZawGpu)' == 'cuda'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" Condition="'$(ZawGpu)' == 'none' or '$(ZawGpu)' == 'coreml'" />
  </ItemGroup>

  <!-- The UI is embedded into the assembly so a single-file publish is fully self-contained. -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <None Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
    <!-- The native window loads its icon from a file. -->
    <EmbeddedResource Include="zawupscale.ico" LogicalName="zawupscale.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZawUpscale.Tests" />
  </ItemGroup>

  <!-- The native packages ship debug symbols and import libraries; a release folder needs only the executable. -->
  <Target Name="DropNativeExtras" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' or '%(Extension)' == '.lib'" />
      <!-- Building for Linux or macOS on Windows, the ONNX Runtime package also copies its Windows DLLs. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'$(ZawTargetsWindows)' != 'true' and '%(Extension)' == '.dll' and $([System.String]::Copy('%(Filename)').StartsWith('onnxruntime'))" />
    </ItemGroup>
  </Target>

</Project>
